ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dynamic Rotating QR Cryptographic HMAC Key
QR_HMAC_SECRET=dev-qr-hmac-secret-zuigo-attendance-2026-replace-in-prod
