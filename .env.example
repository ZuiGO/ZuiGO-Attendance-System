# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database & Cache
DATABASE_URL=postgresql+asyncpg://zuigo:zuigo_dev_2026@localhost:5432/zuigo_attendance
DATABASE_URL_SYNC=postgresql://zuigo:zuigo_dev_2026@localhost:5432/zuigo_attendance
