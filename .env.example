QR_SKEW_TOLERANCE_SECONDS=5

# SMS & WhatsApp OTP Gateway (Twilio / MSG91)
OTP_GATEWAY_PROVIDER=mock # mock, twilio, msg91
OTP_GATEWAY_API_KEY=mock-api-key
OTP_SENDER_ID=ZUIGO
